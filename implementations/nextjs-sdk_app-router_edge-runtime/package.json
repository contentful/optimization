{
  "name": "@implementation/nextjs-sdk_app-router_edge-runtime",
  "private": true,
  "version": "0.0.0",
  "description": "Reference implementation for Next.js App Router Edge runtime request and public permutation handoff routes",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3003",
    "build": "next build",
    "start": "next start --port 3003",
    "clean": "rimraf .next coverage .tsbuildinfo",
    "preview": "pnpm serve:mocks && pnpm start",
    "serve": "pnpm serve:mocks && pnpm serve:app",
    "serve:app": "pnpm build && pm2 start --name nextjs-sdk-app-router-edge-runtime-app \"pnpm start\"",
    "serve:app:stop": "pm2 stop nextjs-sdk-app-router-edge-runtime-app && pm2 delete nextjs-sdk-app-router-edge-runtime-app",
    "serve:mocks": "pm2 start --name nextjs-sdk-app-router-edge-runtime-mocks \"pnpm --dir ../../lib/mocks serve\"",
    "serve:mocks:stop": "pm2 stop nextjs-sdk-app-router-edge-runtime-mocks && pm2 delete nextjs-sdk-app-router-edge-runtime-mocks",
    "serve:stop": "pnpm serve:app:stop; pnpm serve:mocks:stop",
    "serve:e2e": "pnpm build && pnpm start",
    "test:e2e": "E2E_FLAGS=EDGE IMPLEMENTATION=nextjs-sdk_app-router_edge-runtime APP_PORT=3003 pnpm --dir ../../lib/e2e-web test",
    "test:e2e:codegen": "E2E_FLAGS=EDGE IMPLEMENTATION=nextjs-sdk_app-router_edge-runtime APP_PORT=3003 pnpm --dir ../../lib/e2e-web test:codegen",
    "test:e2e:report": "pnpm --dir ../../lib/e2e-web test:report",
    "test:e2e:ui": "E2E_FLAGS=EDGE IMPLEMENTATION=nextjs-sdk_app-router_edge-runtime APP_PORT=3003 pnpm --dir ../../lib/e2e-web test:ui",
    "test:unit": "echo \"No unit tests necessary\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "@contentful/optimization-nextjs": "0.0.0",
    "e2e-web": "file:../../lib/e2e-web",
    "next": "16.2.11",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@types/node": "24.11.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.29.0",
    "eslint-config-next": "16.2.4",
    "pm2": "6.0.14",
    "rimraf": "6.1.3",
    "typescript": "5.9.3"
  }
}
