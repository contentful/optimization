---
import Counter from '../components/Counter'
interface Props {
  title: string
}
const { title } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <p>Contentful Optimization · Astro + React</p>
      <nav aria-label="Main">
        <a href="/">On-demand page</a> <a href="/static">Static page</a>
      </nav>
    </header>
    <main>
      <h1>{title}</h1>
      <slot />
      <aside>
        <h2>Another island</h2>
        <Counter client:idle />
      </aside>
    </main>
  </body>
</html>
<style is:global>
  :root {
    font-family: system-ui, sans-serif;
    color: #172b4d;
    background: #f6f8fc;
  }
  body {
    max-width: 64rem;
    margin: 3rem auto;
    padding: 0 1.5rem;
  }
  nav,
  .controls {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  article,
  aside {
    padding: 1.5rem;
    margin: 1.5rem 0;
    border: 1px solid #bdc9dc;
    border-radius: 0.5rem;
    background: white;
  }
  button {
    padding: 0.6rem 1rem;
    cursor: pointer;
  }
  output {
    display: block;
    overflow-wrap: anywhere;
  }
</style>
