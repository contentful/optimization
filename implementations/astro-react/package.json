{
  "name": "@implementation/astro-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Exploratory Astro and React hybrid personalization reference",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "serve": "HOST=127.0.0.1 PORT=4321 node --env-file=.env ./dist/server/entry.mjs",
    "serve:e2e": "pnpm build && pnpm serve",
    "typecheck": "astro check",
    "lint": "pnpm --dir ../.. exec eslint implementations/astro-react",
    "test:e2e": "playwright test",
    "clean": "rimraf dist .astro playwright-report test-results"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "@astrojs/react": "7.1.1",
    "@contentful/optimization-node": "0.0.0",
    "@contentful/optimization-react-web": "0.0.0",
    "astro": "7.4.2",
    "contentful": "11.10.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "oxc-transform-react": "0.145.0",
    "rimraf": "6.1.3",
    "typescript": "5.9.3"
  }
}
