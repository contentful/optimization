{
  "name": "@contentful/optimization-react-web",
  "description": "React SDK for Contentful Optimization",
  "version": "1.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contentful/optimization.git",
    "directory": "packages/web/frameworks/react-web-sdk"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./next-app": {
      "import": {
        "types": "./dist/next-app.d.mts",
        "default": "./dist/next-app.mjs"
      },
      "require": {
        "types": "./dist/next-app.d.cts",
        "default": "./dist/next-app.cjs"
      }
    },
    "./next-pages": {
      "import": {
        "types": "./dist/next-pages.d.mts",
        "default": "./dist/next-pages.mjs"
      },
      "require": {
        "types": "./dist/next-pages.d.cts",
        "default": "./dist/next-pages.cjs"
      }
    },
    "./react-router": {
      "import": {
        "types": "./dist/react-router.d.mts",
        "default": "./dist/react-router.mjs"
      },
      "require": {
        "types": "./dist/react-router.d.cts",
        "default": "./dist/react-router.cjs"
      }
    },
    "./tanstack-router": {
      "import": {
        "types": "./dist/tanstack-router.d.mts",
        "default": "./dist/tanstack-router.mjs"
      },
      "require": {
        "types": "./dist/tanstack-router.d.cts",
        "default": "./dist/tanstack-router.cjs"
      }
    },
    "./logger": {
      "import": {
        "types": "./dist/logger.d.mts",
        "default": "./dist/logger.mjs"
      },
      "require": {
        "types": "./dist/logger.d.cts",
        "default": "./dist/logger.cjs"
      }
    },
    "./web-sdk": {
      "import": {
        "types": "./dist/web-sdk.d.mts",
        "default": "./dist/web-sdk.mjs"
      },
      "require": {
        "types": "./dist/web-sdk.d.cts",
        "default": "./dist/web-sdk.cjs"
      }
    },
    "./core-sdk": {
      "import": {
        "types": "./dist/core-sdk.d.mts",
        "default": "./dist/core-sdk.mjs"
      },
      "require": {
        "types": "./dist/core-sdk.d.cts",
        "default": "./dist/core-sdk.cjs"
      }
    },
    "./handoff": {
      "import": {
        "types": "./dist/handoff.d.mts",
        "default": "./dist/handoff.mjs"
      },
      "require": {
        "types": "./dist/handoff.d.cts",
        "default": "./dist/handoff.cjs"
      }
    },
    "./analytics": {
      "import": {
        "types": "./dist/analytics.d.mts",
        "default": "./dist/analytics.mjs"
      },
      "require": {
        "types": "./dist/analytics.d.cts",
        "default": "./dist/analytics.cjs"
      }
    },
    "./tracking-attributes": {
      "import": {
        "types": "./dist/tracking-attributes.d.mts",
        "default": "./dist/tracking-attributes.mjs"
      },
      "require": {
        "types": "./dist/tracking-attributes.d.cts",
        "default": "./dist/tracking-attributes.cjs"
      }
    },
    "./api-client": {
      "import": {
        "types": "./dist/api-client.d.mts",
        "default": "./dist/api-client.mjs"
      },
      "require": {
        "types": "./dist/api-client.d.cts",
        "default": "./dist/api-client.cjs"
      }
    },
    "./api-schemas": {
      "import": {
        "types": "./dist/api-schemas.d.mts",
        "default": "./dist/api-schemas.mjs"
      },
      "require": {
        "types": "./dist/api-schemas.d.cts",
        "default": "./dist/api-schemas.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "buildTools": {
    "bundleSize": {
      "gzipBudgets": {
        "index.cjs": 7200,
        "index.mjs": 6300,
        "next-app.cjs": 7700,
        "next-app.mjs": 7100,
        "next-pages.cjs": 7800,
        "next-pages.mjs": 7100,
        "react-router.cjs": 7700,
        "react-router.mjs": 7100,
        "tanstack-router.cjs": 7800,
        "tanstack-router.mjs": 7100,
        "handoff.cjs": 800,
        "handoff.mjs": 200,
        "analytics.cjs": 800,
        "analytics.mjs": 200,
        "tracking-attributes.cjs": 800,
        "tracking-attributes.mjs": 200
      }
    }
  },
  "scripts": {
    "build": "pnpm clean && pnpm build:dist",
    "build:ci": "pnpm build:dist",
    "build:dist": "rslib build && build-tools check-client-boundary-exports ./src ./dist && build-tools emit-dual-dts ./dist",
    "build:rsdoctor": "RSDOCTOR=true rslib build && build-tools emit-dual-dts ./dist",
    "clean": "rimraf ./.rsdoctor ./.rslib ./dist ./coverage .tsbuildinfo ./node_modules/.cache/rspack",
    "dev": "rsbuild dev --host 0.0.0.0 -c dev/rsbuild.config.ts",
    "dev:launch": "./scripts/launch-dev-harness.sh",
    "size:check": "pnpm build:dist && build-tools bundle-size",
    "size:report": "build-tools bundle-size --report-only",
    "test:unit": "rstest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@contentful/optimization-web": "workspace:*"
  },
  "devDependencies": {
    "@rsbuild/core": "catalog:",
    "@rsbuild/plugin-react": "^1.4.2",
    "@rslib/core": "catalog:",
    "@rstest/core": "catalog:",
    "@rstest/coverage-istanbul": "catalog:",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@tanstack/react-router": "^1.132.33",
    "build-tools": "workspace:*",
    "contentful": "catalog:",
    "happy-dom": "catalog:",
    "next": "^16.2.11",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router-dom": "^7.14.2",
    "rimraf": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-router": ">=1.0.0",
    "next": ">=13.0.0",
    "react": ">=18.3.1",
    "react-dom": ">=18.3.1",
    "react-router-dom": ">=6.4.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-router": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  }
}
